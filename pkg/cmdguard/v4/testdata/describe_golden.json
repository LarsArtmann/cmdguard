  "flags": [
    {
      "name": "api-token",
      "type": "string",
      "usage": "API token for authenticated calls",
      "env": "FIXTURE_API_TOKEN"
    },
    {
      "name": "environment",
      "shorthand": "e",
      "type": "string",
      "default": "dev",
