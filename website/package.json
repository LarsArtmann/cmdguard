{
  "name": "cmdguard-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for cmdguard — type-safe CLI framework for Go",
  "keywords": [
    "astro",
    "cli",
    "cli-framework",
    "cobra",
    "command-line",
    "dependency-injection",
    "flags",
    "go",
    "golang",
    "starlight",
    "struct-tags",
    "type-safe"
  ],
  "homepage": "https://cmdguard.lars.software",
  "bugs": "https://github.com/LarsArtmann/cmdguard/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/LarsArtmann/cmdguard.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/fix-csp.mjs",
