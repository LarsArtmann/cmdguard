---
import { siteConfig } from '../data/config';
import { heroCode } from '../data/hero-code';
import Icon from './Icon.astro';

async function getGitHubStars(): Promise<number | null> {
  try {
    const response = await fetch('https://api.github.com/repos/LarsArtmann/cmdguard', {
      headers: {
        'Accept': 'application/vnd.github.v3+json',
      },
    });
    if (!response.ok) return null;
    const data = await response.json();
    return data.stargazers_count as number;
  } catch {
    return null;
  }
}

const stars = await getGitHubStars();
const starsText =
  stars === null ? 'Star on GitHub' : stars === 1 ? '1 Star' : `${stars} Stars`;

const goKeywords = new Set([
  'func', 'return', 'if', 'else', 'for', 'range', 'var', 'const', 'type',
  'struct', 'interface', 'go', 'defer', 'select', 'switch', 'case', 'default',
  'package', 'import', 'map', 'chan', 'nil', 'true', 'false', 'err',
]);

function escapeHtml(value: string): string {
  return value
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function highlightGo(source: string): string {
  const token = /(\/\/[^\n]*)|("(?:[^"\\]|\\.)*")|\b([A-Za-z_]\w*)\b/g;
  let out = '';
  let last = 0;

  for (const match of source.matchAll(token)) {
    const index = match.index ?? 0;
    out += escapeHtml(source.slice(last, index));

    const [text, comment, str, word] = match;

    if (comment) {
      out += `<span class="text-code-comment">${escapeHtml(comment)}</span>`;
    } else if (str) {
      out += `<span class="text-amber">${escapeHtml(str)}</span>`;
    } else if (word && goKeywords.has(word)) {
      out += `<span class="text-text-muted">${escapeHtml(word)}</span>`;
    } else if (word && /^[A-Z]/.test(word)) {
      out += `<span class="text-accent">${escapeHtml(word)}</span>`;
    } else {
      out += escapeHtml(text);
    }

    last = index + text.length;
  }

  return out + escapeHtml(source.slice(last));
}

const highlightedCode = highlightGo(heroCode);
---

<section class="relative flex items-center justify-center overflow-hidden pt-32 pb-16">
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-accent/5 blur-[120px] rounded-full pointer-events-none"></div>
  <div class="relative max-w-3xl xl:max-w-6xl mx-auto px-6 text-center">
    <a class="inline-flex items-center gap-1.5 px-3.5 py-1.5 border border-border rounded-md text-text-secondary text-[0.8125rem] font-medium no-underline hover:border-accent hover:text-accent transition-all duration-150 mb-6" href={siteConfig.github} target="_blank" rel="noopener">
      <Icon name="star" size={14} />
      {starsText}
    </a>
    <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] font-bold tracking-tighter leading-tight mb-6">
      <span>From flags to </span><em class="not-italic text-accent font-extrabold">shutdown</em><span>, type-safe.</span>
    </h1>

    <p class="text-[clamp(1.125rem,2.5vw,1.25rem)] text-text-muted max-w-3xl mx-auto mb-10 leading-relaxed">
      The only Go CLI framework that unifies <em class="not-italic text-text-primary">type-safe flags</em>,
      <em class="not-italic text-text-primary"> dependency injection</em> with lifecycle management, and
      <em class="not-italic text-text-primary"> zero-panic error contracts</em>.
      Wraps Cobra — keep full compatibility, lose the footguns.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a href="/getting-started/installation/" data-astro-prefetch class="px-6 py-3 bg-accent text-on-accent font-semibold rounded-lg text-sm hover:bg-accent-hover transition-colors duration-150 inline-flex items-center gap-2 border-none cursor-pointer">Get Started &rarr;</a>
      <div class="flex items-center gap-2 py-2.5 px-4 rounded-lg bg-bg-card-solid border border-border font-mono text-sm text-text-primary select-all">$ go get github.com/larsartmann/cmdguard/v5</div>
    </div>

    <div class="relative max-w-xl mx-auto">
      <div class="absolute -inset-4 bg-gradient-to-r from-accent/10 via-transparent to-accent/10 rounded-2xl blur-6 pointer-events-none"></div>
      <div class="relative rounded-xl border border-border bg-bg-code shadow-2xl overflow-hidden code-preview">
        <div class="flex items-center gap-1.5 px-4 py-3 border-b border-border">
          <span class="text-accent font-mono text-sm select-none">❯</span>
          <span class="ml-1 text-xs text-text-muted font-mono">main.go</span>
        </div>
        <pre tabindex="0" class="p-4 text-left text-sm font-mono leading-relaxed overflow-x-auto relative"><code id="hero-code" set:html={highlightedCode} /></pre>
        <button class="absolute top-2 right-2 bg-code-inline-bg/80 border border-border rounded-md text-text-muted px-1.5 py-1.5 cursor-pointer text-xs font-mono hover:text-text-primary hover:border-border-hover transition-all duration-150 opacity-0 [.code-preview:hover_&]:opacity-100" id="copy-btn" data-code={heroCode} aria-label="Copy code to clipboard">Copy</button>
      </div>
    </div>
  </div>
</section>

<script is:inline src="/js/copy-code.js"></script>
