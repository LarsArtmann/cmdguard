{
  "schema_version": "1",
  "name": "taskctl",
  "short": "A production-grade task manager CLI",
  "version": "1.0.0",
  "flags": [
    {
      "name": "admin-email",
      "type": "string",
      "default": "admin@example.com",
      "usage": "Admin contact email"
    },
    {
      "name": "api-url",
      "type": "string",
      "default": "http://localhost:8080",
      "usage": "API base URL"
    },
    {
      "name": "data-dir",
      "shorthand": "d",
      "type": "string",
      "default": "./data",
      "usage": "Directory for task storage",
      "env": "TASK_DATA_DIR"
    },
    {
      "name": "help",
      "shorthand": "h",
      "type": "bool",
      "default": "false",
      "usage": "help for taskctl"
    },
    {
