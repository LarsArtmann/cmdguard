      "shorthand": "l",
      "type": "string",
      "default": "info",
      "usage": "Log level (debug, info, warn, error) (one of: debug, info, warn, error)",
      "env": "TASK_LOG_LEVEL"
    },
    {
      "name": "no-color",
      "type": "bool",
      "default": "false",
      "usage": "Disable colored output (also respected via NO_COLOR env var)"
    },
    {
      "name": "port",
      "type": "string",
      "default": "8080",
      "usage": "API port"
    },
    {
      "name": "timeout",
      "type": "string",
      "default": "30s",
      "usage": "Default operation timeout"
    },
    {
      "name": "verbose",
      "shorthand": "v",
      "type": "count",
      "default": "0",
      "usage": "Verbosity (-v, -vv, -vvv)",
      "count": true
    },
    {
      "name": "version",
      "type": "bool",
      "default": "false",
      "usage": "version for taskctl"
    }
  ],
  "commands": [
    {
      "name": "add",
      "path": "taskctl add",
      "short": "Add a new task",
      "long": "# Add Task\n\nCreate a new task with a **title** and *priority*.\n\nThe `--title` flag is **required** and will prompt interactively if omitted.\n\nPriority must be one of: `low`, `medium`, `high` (default: `medium`).",
      "example": "taskctl add --title \"Fix bug\" --priority high",
      "group": "tasks",
      "flags": [
        {
          "name": "admin-email",
          "type": "string",
          "default": "admin@example.com",
          "usage": "Admin contact email",
          "inherited": true
        },
        {
          "name": "api-url",
          "type": "string",
          "default": "http://localhost:8080",
          "usage": "API base URL",
          "inherited": true
        },
        {
          "name": "data-dir",
          "shorthand": "d",
          "type": "string",
          "default": "./data",
          "usage": "Directory for task storage",
          "inherited": true
        },
        {
          "name": "help",
          "shorthand": "h",
          "type": "bool",
          "default": "false",
          "usage": "help for add"
        },
        {
          "name": "log-level",
          "shorthand": "l",
          "type": "string",
          "default": "info",
          "usage": "Log level (debug, info, warn, error) (one of: debug, info, warn, error)",
          "inherited": true
        },
        {
          "name": "no-color",
          "type": "bool",
          "default": "false",
          "usage": "Disable colored output (also respected via NO_COLOR env var)",
          "inherited": true
        },
        {
          "name": "port",
          "type": "string",
          "default": "8080",
          "usage": "API port",
          "inherited": true
        },
        {
          "name": "priority",
          "shorthand": "P",
          "type": "string",
          "default": "medium",
          "usage": "Priority",
          "values": [
            "low",
            "medium",
            "high"
          ]
        },
        {
          "name": "timeout",
          "type": "string",
          "default": "30s",
          "usage": "Default operation timeout",
          "inherited": true
        },
