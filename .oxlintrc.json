{
  "plugins": [
    "node",
    "oxc",
    "typescript",
    "unicorn"
  ],
  "categories": {
    "perf": "warn",
    "style": "warn",
    "restriction": "warn",
    "nursery": "off",
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "warn"
  },
  "rules": {
    "oxc/no-optional-chaining": "off",
    "oxc/no-rest-spread-properties": "off",
    "oxc/no-async-await": "off"
  },
  "env": {
    "builtin": true,
    "node": true
  }
}
