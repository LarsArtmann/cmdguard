# cmdguard v2 Architecture Diagram
# Type-safe CLI construction with DI and generics

direction: right

# External Dependencies
external: {
  label: External Dependencies
  style: {
    fill: "#f0f0f0"
    stroke: "#666"
    stroke-dash: 3
  }

  cobra: {
    label: |go
      spf13/cobra
      CLI framework
    |
    shape: rectangle
  }

  fang: {
    label: |go
      charm.land/fang/v2
      Styled help
    |
    shape: rectangle
  }

  samberdo: {
    label: |go
      samber/do/v2
      Dependency Injection
    |
    shape: rectangle
  }

  huh: {
    label: |go
      charm.land/huh/v2
      Interactive prompts
    |
    shape: rectangle
  }

  glamour: {
    label: |go
      charm.land/glamour/v2
      Markdown rendering
    |
    shape: rectangle
  }

  otel: {
    label: |go
      OpenTelemetry
      Tracing spans
    |
    shape: rectangle
  }

  gooutput: {
    label: |go
      go-output
      12 output formats
    |
    shape: rectangle
  }
}

# Public API Layer (v2)
public: {
  label: Public API (v2)
  style: {
    fill: "#e8f5e9"
    stroke: "#388e3c"
  }

  cli: {
    label: |go
      cli.go, cli_options.go
      CLI[T]
      - NewCLI[T]()
      - AddCommand()
      - Execute()
      - Scope()
      - Config()
      - NoColor()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  command: {
    label: |go
      command.go, command_options.go

      Command[T, F]
      - NewCommand[T, F]()
      - NewParentCommand[T, F]()
      - 21 functional options
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  scope: {
    label: |go
      scope.go

      Scope
      - Provide()
      - ProvideValue()
      - Invoke[T]()
      - HealthCheck()
      - Shutdown()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  flags: {
    label: |go
      flags.go, flags_parse.go

      FlagRegistry
      - Struct tag parsing
      - Type handlers
      - Validation
      - Typo suggestions
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  middleware: {
    label: |go
      middleware.go

      Middleware Chain
      - TimingMiddleware
      - RecoveryMiddleware
      - SpinnerMiddleware
      - TelemetryMiddleware
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  types: {
    label: |go
      types_*.go

      Custom Types
      - Email, URL, Port
      - FilePath, HostPort
      - Duration, LogLevel
      - Enum[T]
      - NoFlags
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  errors: {
    label: |go
      errors.go

      Error Types
      - 40+ sentinels
      - CommandError
      - FlagError
      - ServiceError
      - ExitError
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }
}

# Configuration Layer
config: {
  label: Config & Prompts
  style: {
    fill: "#fff3e0"
    stroke: "#f57c00"
  }

  configfile: {
    label: |go
      config_file.go, configload/

      Config File Loading
      - JSON (built-in)
      - YAML (go-faster/yaml)
      - TOML (pelletier/go-toml)
    |
    shape: rectangle
    style: {
      fill: "#ffe0b2"
      stroke: "#f57c00"
    }
  }

  prompts: {
    label: |go
      prompts.go

      Interactive Prompts
      - Input, Select, Confirm
      - prompt:"?" struct tag
      - WithPromptOnMissing
    |
    shape: rectangle
    style: {
      fill: "#ffe0b2"
      stroke: "#f57c00"
    }
  }
}

# Example
examples: {
  label: Example
  style: {
    fill: "#e1f5fe"
    stroke: "#0288d1"
  }

  taskctl: {
    label: |go
      examples/taskctl/
      Production task manager CLI
      - All features demonstrated
      - ~66 integration tests
    |
    shape: rectangle
    style: {
      fill: "#b3e5fc"
      stroke: "#0288d1"
    }
  }
}

# Relationships
public.cli -> public.command: AddCommand
public.cli -> public.scope: Scope()
public.cli -> public.flags: flag registration
public.cli -> public.middleware: WithMiddleware
public.cli -> external.cobra: wraps
public.cli -> external.fang: styled help
public.scope -> external.samberdo: wraps
public.command -> public.flags: WithFlags
public.command -> public.errors: validation
public.config.configfile -> public.flags: defaults
public.config.prompts -> external.huh: TUI prompts
public.middleware -> external.otel: spans
public.cli -> external.gooutput: output formats
public.cli -> external.glamour: markdown help
