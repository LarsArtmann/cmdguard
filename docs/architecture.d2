# cmdguard v2 Architecture Diagram
# Type-safe CLI construction with DI and generics

direction: right

# External Dependencies
external: {
  label: External Dependencies
  style: {
    fill: "#f0f0f0"
    stroke: "#666"
    stroke-dash: 3
  }

  cobra: {
    label: |go
      spf13/cobra
      CLI framework
    |
    shape: rectangle
  }

  fang: {
    label: |go
      charmbracelet/fang
      Styling
    |
    shape: rectangle
  }

  samberdo: {
    label: |go
      samber/do/v2
      Dependency Injection
    |
    shape: rectangle
  }
}

# Public API Layer (v2)
public: {
  label: Public API (v2)
  style: {
    fill: "#e8f5e9"
    stroke: "#388e3c"
  }

  guarded: {
    label: |go
      pkg/cmdguard/v2
      guard.go

      GuardedCommand[T, F]
      - New[T, F]()
      - AddCommand()
      - Execute()
      - Scope()
      - Config()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  command: {
    label: |go
      command.go

      Command[T, F]
      - Use, Short, Long
      - Flags F
      - RunE, PreRunE, PostRunE
      - Validate()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  scope: {
    label: |go
      scope.go

      Scope
      - Provide()
      - ProvideValue()
      - Invoke[T]()
      - Child()
      - HealthCheck()
      - Shutdown()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  flags: {
    label: |go
      flags.go

      FlagRegistry
      - RegisterFlags()
      - ParseFlags()
      - ValidateFlags()
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  types: {
    label: |go
      types.go

      Custom Types
      - LogLevel
      - LogFormat
      - Duration
      - Enum[T]
      - NoFlags
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }

  errors: {
    label: |go
      errors.go

      Error Types
      - *CommandError
      - *FlagError
      - *ServiceError
      - *ConfigError
    |
    shape: rectangle
    style: {
      fill: "#c8e6c9"
      stroke: "#388e3c"
    }
  }
}

# Internal Layer
internal: {
  label: Internal Packages
  style: {
    fill: "#fff3e0"
    stroke: "#f57c00"
  }

  config: {
    label: |go
      internal/config/

      Config Provider
      - Environment variables
      - CMDGUARD_* prefix
    |
    shape: rectangle
    style: {
      fill: "#ffe0b2"
      stroke: "#f57c00"
    }
  }

  logging: {
    label: |go
      internal/logging/

      Logger
      - Structured logging (slog)
      - Log level management
    |
    shape: rectangle
    style: {
      fill: "#ffe0b2"
      stroke: "#f57c00"
    }
  }
}

# Examples Layer
examples: {
  label: Examples
  style: {
    fill: "#e1f5fe"
    stroke: "#0288d1"
  }

  basic: {
    label: examples/basic/
    shape: rectangle
    style: {fill: "#b3e5fc"}
  }

  typed: {
    label: examples/typed/
    shape: rectangle
    style: {fill: "#b3e5fc"}
  }

  di: {
    label: examples/di/
    shape: rectangle
    style: {fill: "#b3e5fc"}
  }

  middleware: {
    label: examples/middleware/
    shape: rectangle
    style: {fill: "#b3e5fc"}
  }
}

# Relationships
public.guarded -> public.command: uses
public.guarded -> public.scope: contains
public.guarded -> public.flags: uses
public.guarded -> public.errors: returns

public.command -> public.types: uses
public.flags -> public.types: uses
public.scope -> public.errors: returns

# External Dependencies
public.guarded -> external.cobra: wraps
public.scope -> external.samberdo: uses
public.flags -> external.cobra: registers

# Internal Usage
public.guarded -> internal.config: reads
public.guarded -> internal.logging: uses

# Examples Usage
examples.basic -> public.guarded: demonstrates
examples.typed -> public.guarded: demonstrates
examples.typed -> public.command: demonstrates
examples.di -> public.scope: demonstrates
examples.middleware -> public.command: demonstrates
