    shape: cylinder
    style: {
      fill: "#fce4ec"
      stroke: "#c2185b"
      stroke-width: 2
    }
  }

  issue: {
    style: {
      fill: "#ffebee"
      stroke: "#c62828"
      stroke-width: 2
      border-radius: 4
