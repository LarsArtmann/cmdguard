  sub_modules_box: "5 sub-modules — unchanged\nUnix-philosophy split is already correct.\nNo consolidation (each composes independently).\nNo further split (each does one thing at the right depth)." {
    style.fill: "#18181d"
    style.font-color: "#6eb5ff"
